	quest.196648B515B1416E.quest_desc: ["{image:kubejs:textures/ftbquests/stages/machines_mk2.png width:200 height:150 align:center}"]
	quest.196648B515B1416E.quest_subtitle: "더 많은 항목을 자동화하는 기능을 잠금 해제하는 데 더 많은 기계가 사용됩니다."
	quest.196648B515B1416E.title: "&o&l&7고급 가공"
	quest.1970D2F438BE7694.quest_desc: ["ChoiceTheorem의 Overhauled Village는 지형, 테마 및 생물 군계에 맞게 각각 맞춤화된 14개의 약탈자 전초 기지 변형을 추가하여 Minecraft에 새롭고 향상된 약탈자 전초 기지를 추가하는 모드입니다."]
	quest.1970D2F438BE7694.quest_subtitle: "새롭게 개선된 약탈자 전초기지"
