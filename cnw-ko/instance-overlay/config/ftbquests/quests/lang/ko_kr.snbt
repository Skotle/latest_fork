	quest.5F2177D4CE1D09E9.title: "&o&7&l기후학자"
	quest.5F94733FFDAEA465.quest_desc: ["&6(WIP 기능)&r 작물은 심어진 생물 군계의 온도에 민감합니다. 이 도구를 사용하면 온도를 측정하여 생물 군계가 적합한지 여부를 결정하는 데도 도움이 됩니다."]
	quest.5F94733FFDAEA465.quest_subtitle: "주변 온도를 측정하는 데 사용합니다."
	quest.5F94733FFDAEA465.title: "&o&l&7온도계"
