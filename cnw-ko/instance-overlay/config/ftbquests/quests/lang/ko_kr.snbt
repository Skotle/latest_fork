	quest.163BA301979066BF.quest_desc: ["{image:kubejs:textures/ftbquests/stages/astrology.png width:200 height:150 align:center}"]
	quest.163BA301979066BF.quest_subtitle: "별과 행성을 연구하는 데 사용할 수 있는 장비"
	quest.163BA301979066BF.title: "&7&o&l천체 사진 장비"
	quest.1695AAB2C2B08A25.quest_desc: [
		"&l사용 방법:&r"
		""
		"1. 통풍구를 찾으세요. 통풍구는 표면 어디에서나 발견되지만 수중에서 더 쉽게 발견됩니다."
		""
		"2. 마그마가 있는 것을 제외하고 통풍구를 구성하는 광석처럼 보이는 블록, 즉 휴면 광석을 찾을 때까지 통풍구 내부의 블록을 파냅니다."
		""
		"3. 어떤 수단을 써서라도 휴면광석을 폭발시키세요."
		""
		"4. 휴면 용융 분출구 안의 마그마가 더 밝아지는 것을 보면 이제 활성 용융 분출구가 된 것을 알 수 있습니다."
		""
		"5. 활성화된 용융 분출구에 용암을 (가급적 자동화된 방법을 통해) 쏟아 붓고 용암이 해당 광석으로 변하는 것을 관찰합니다."
		""
		"6. 광석을 자원으로 가공하거나 건축에 사용하세요."
	]
	quest.1695AAB2C2B08A25.quest_subtitle: "모든 종류의 자원으로 변환될 수 있는 재생 가능한 광석 공급원"
	quest.1695AAB2C2B08A25.title: "&a위치하고 있다: &r휴면 용해 분출구"
	quest.16B893087803026C.quest_desc: ["ID 카드를 사용하면 다른 플레이어가 Numismatics의 보호 블록(Vendor, Depositors 및 Blaze Bankers)에 액세스할 수 있으므로 비즈니스 파트너에게 쉽게 액세스할 수 있습니다."]
	quest.16B893087803026C.quest_subtitle: "다른 플레이어가 Numismatics의 보호 블록에 접근할 수 있도록 하는 데 사용됩니다."
	quest.1749AD0F9331E5FD.quest_desc: ["(아직 구현되지 않은 거래의 이미지 예시)"]
