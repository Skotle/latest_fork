#Activates while holding Prototype Zeta. First, run effects if it's just been selected.
execute unless entity @s[tag=ZetaHolding] run function explorers_eve:item/prototype_zeta/hold_start

#Whenever the player deals damage, convert it into Zeta damage that won't get reset. This function also checks to add charges.
execute if score @s Damage matches 1.. run function explorers_eve:item/prototype_zeta/damage_convert

#Display charging statistics over the hotbar.
execute unless score @s ZetaDamage matches 40.. run title @s actionbar [{"text":"요금","color":"dark_purple","bold":true},{"text":" |","color":"white","bold":false},{"color":"yellow","bold":true,"score":{"name":"@s","objective":"ZetaCharges"}},{"text":"|","color":"white","bold":false},{"text":"  ■■■■■■■■■■","color":"gray","bold":false}]
